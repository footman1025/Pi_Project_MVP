# Copy to .env.local for local dev (never commit real keys)
# Get a free key: https://console.groq.com/keys

# Server-side only (Vite proxy + Vercel /api/groq) — do NOT use VITE_ prefix for the secret
GROQ_API_KEY=gsk_your_key_here

# Client UI flag only (safe to expose) — enables “Online · Groq AI” in the assistant
VITE_GROQ_ENABLED=true

# Optional model override
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# --- Web Push (phones / tablets / desktops when Pi is closed) ---
# Generate: npx web-push generate-vapid-keys
# Client (safe to expose) — must be set at BUILD time on Vercel:
VITE_VAPID_PUBLIC_KEY=
# Server (Vercel /api/push — keep private):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Required for /api/push to look up subscriptions:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://enozvyhkjbqsgcjonxlr.supabase.co
# Optional: Database Webhook → POST /api/push-hook (header x-pi-push-secret)
# Enables closed-app alerts even if the sender’s browser never finished fan-out.
PUSH_HOOK_SECRET=
# --- Email (Resend) — Contact handoffs + optional notification alerts ---
RESEND_API_KEY=re_xxxxx
# Test sender (only delivers to RESEND_ACCOUNT_EMAIL). For ANY visitor email, verify a domain:
EMAIL_FROM=Pi <onboarding@resend.dev>
# Your Resend signup email — required while EMAIL_FROM uses @resend.dev (team alerts land here):
RESEND_ACCOUNT_EMAIL=gabriel961025@gmail.com
# Optional extra team copies (need verified domain to reach non-account addresses):
HANDOFF_NOTIFY_EMAIL=gabriel961025@gmail.com
# Production: verify domain at resend.com/domains, then e.g. EMAIL_FROM=Pi <noreply@yourdomain.com>
VITE_PUBLIC_APP_URL=https://pi-project-mvp.vercel.app

# --- Featured Opportunity (willingness-to-pay) ---
# Without STRIPE_SECRET_KEY the app records honest "intent" only (No Surprise).
# With Stripe: Checkout €9 / 7 days (override price/days below).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_FEATURED_PRICE_CENTS=900
# STRIPE_FEATURED_DAYS=7

