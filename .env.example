# Copy to .env.local and fill in (never commit real keys)
# Get a free key: https://console.groq.com/keys
#
# No spaces around "=".
# The browser never calls Groq directly (CORS) — Vite/Vercel /api/groq proxies it.

VITE_GROQ_API_KEY=gsk_your_key_here

# Preferred for production (Vercel): set GROQ_API_KEY instead of exposing VITE_ prefix
# GROQ_API_KEY=gsk_your_key_here
# VITE_GROQ_ENABLED=true

# Optional — default is llama-3.3-70b-versatile
# VITE_GROQ_MODEL=llama-3.3-70b-versatile
